.data:0800655E                                         ; usage+11↑o
.data:08006577 L_146           db 'usage: nasm [-@ response file] [-o outfile] [-f format] [-l listf'
.data:08006577                                         ; help+A↑o
.data:08006577                 db 'ile]',0Ah
.data:08006577                 db '            [options...] [--] filename',0Ah
.data:08006577                 db '    or nasm -v (or --v) for version info',0Ah
.data:08006577                 db 0Ah
.data:08006577                 db 0Ah
.data:08006577                 db 'Response files should contain command line parameters,',0Ah
.data:08006577                 db 'one per line.',0Ah
.data:08006577                 db 0Ah
.data:08006577                 db '    -t            assemble in SciTech TASM compatible mode',0Ah,0
.data:08006691 L_147           db '    -E (or -e)    preprocess only (writes output to stdout by def'
.data:08006691                                         ; help+18↑o
.data:08006691                 db 'ault)',0Ah
.data:08006691                 db '    -a            don',27h,'t preprocess (assemble only)',0Ah
.data:08006691                 db '    -M            generate Makefile dependencies on stdout',0Ah
.data:08006691                 db '    -MG           d:o, missing files assumed generated',0Ah
.data:08006691                 db '    -MF file      set Makefile dependency file',0Ah
.data:08006691                 db '    -MD file      assemble and generate dependencies',0Ah
.data:08006691                 db '    -MT file      dependency target name',0Ah
.data:08006691                 db '    -MQ file      dependency target name (quoted)',0Ah
.data:08006691                 db '    -MP           emit phony target',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -Zfile        redirect error messages to file',0Ah
.data:08006691                 db '    -s            redirect error messages to stdout',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -g            generate debugging information',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -F format     select a debugging format',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -gformat      same as -g -F format',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -o outfile    write output to an outfile',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -f format     select an output format',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -l listfile   write listing to a listfile',0Ah
.data:08006691                 db 0Ah
.data:08006691                 db '    -Ipath        add a pathname to the include file path',0Ah,0
.data:08006A12 L_148           db '    -Oflags...    optimize opcodes, immediates and branch offsets'
.data:08006A12                                         ; help+26↑o
.data:08006A12                 db 0Ah
.data:08006A12                 db '       -O0        no optimization',0Ah
.data:08006A12                 db '       -O1        minimal optimization',0Ah
.data:08006A12                 db '       -Ox        multipass optimization (default)',0Ah
.data:08006A12                 db '       -Ov        display the number of passes executed at the en'
.data:08006A12                 db 'd',0Ah
.data:08006A12                 db '    -Pfile        pre-include a file (also --include)',0Ah
.data:08006A12                 db '    -Dmacro[=str] pre-define a macro',0Ah
.data:08006A12                 db '    -Umacro       undefine a macro',0Ah
.data:08006A12                 db '    -Xformat      specifiy error reporting format (gnu or vc)',0Ah
.data:08006A12                 db '    -w+foo        enable warning foo (equiv. -Wfoo)',0Ah
.data:08006A12                 db '    -w-foo        disable warning foo (equiv. -Wno-foo)',0Ah
.data:08006A12                 db '    -w[+-]error[=foo]',0Ah
.data:08006A12                 db '                  promote [specific] warnings to errors',0Ah
.data:08006A12                 db '    -h            show invocation summary and exit (also --help)',0Ah
.data:08006A12                 db 0Ah
.data:08006A12                 db '   --pragma str   pre-executes a specific %%pragma',0Ah
.data:08006A12                 db '   --before str   add line (usually a preprocessor statement) bef'
.data:08006A12                 db 'ore the input',0Ah
.data:08006A12                 db '   --prefix str   prepend the given string to all the given strin'
.data:08006A12                 db 'g',0Ah
.data:08006A12                 db '                  to all extern, common and global symbols (also '
.data:08006A12                 db '--gprefix)',0Ah
.data:08006A12                 db '   --postfix str  append the given string to all the given string'
.data:08006A12                 db 0Ah
.data:08006A12                 db '                  to all extern, common and global symbols (also '
.data:08006A12                 db '--gpostfix)',0Ah
.data:08006A12                 db '   --lprefix str  prepend the given string to all other symbols',0Ah
.data:08006A12                 db '   --lpostfix str append the given string to all other symbols',0Ah
.data:08006A12                 db '   --keep-all     output files will not be removed even if an err'
.data:08006A12                 db 'or happens',0Ah
.data:08006A12                 db '   --no-line      ignore %%line directives in input',0Ah
.data:08006A12                 db '   --limit-X val  set execution limit X',0Ah,0
