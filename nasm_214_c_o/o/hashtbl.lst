.text:08000B15 ; =============== S U B R O U T I N E =======================================
.text:08000B15
.text:08000B15 ; Attributes: bp-based frame
.text:08000B15
.text:08000B15                 public hash_iterate
.text:08000B15 hash_iterate    proc near               ; ...
.text:08000B15
.text:08000B15 tmp             = dword ptr -0Ch
.text:08000B15 ep              = dword ptr -8
.text:08000B15 np              = dword ptr -4
.text:08000B15 head            = dword ptr  8
.text:08000B15 iterator        = dword ptr  0Ch
.text:08000B15 key             = dword ptr  10h
.text:08000B15
.text:08000B15                 push    ebp             ; /* Iterate over all members of a hash set.
.text:08000B15                                         ;    For the first call, iterator should be initialized to NULL.
.text:08000B15                                         ;    Returns the data pointer, or NULL on failure. */
.text:08000B15                                         ;
.text:08000B15                                         ; void *hash_iterate(const struct hash_table *head,
.text:08000B15                                         ;                    struct hash_tbl_node **iterator,
.text:08000B15                                         ;                    const char **key)
.text:08000B16                 mov     ebp, esp
.text:08000B18                 sub     esp, 12
.text:08000B1E                 nop
.text:08000B1F                 mov     eax, [ebp+iterator]
.text:08000B22                 mov     ecx, [eax]
.text:08000B24                 mov     [ebp+np], ecx   ; struct hash_tbl_node *np = *iterator;
.text:08000B27                 mov     eax, [ebp+head]
.text:08000B2A                 mov     ecx, [ebp+head]
.text:08000B2D                 add     ecx, 8
.text:08000B30                 mov     edx, [ecx]
.text:08000B32                 shl     edx, 4
.text:08000B35                 mov     ecx, [eax]
.text:08000B37                 add     ecx, edx
.text:08000B39                 mov     [ebp+ep], ecx   ; struct hash_tbl_node *ep = head->table + head->size;
.text:08000B3C                 mov     eax, [ebp+np]
.text:08000B3F                 cmp     eax, 0          ; if (!np) {
.text:08000B42                 jz      hite_1
.text:08000B48                 jmp     hite_3
.text:08000B4D ; ---------------------------------------------------------------------------
.text:08000B4D
.text:08000B4D hite_1:                                 ; ...
.text:08000B4D                 mov     eax, [ebp+head]
.text:08000B50                 mov     ecx, [eax]
.text:08000B52                 mov     [ebp+np], ecx   ; np = head->table;
.text:08000B55                 mov     eax, [ebp+np]   ; if (!np)
.text:08000B58                 cmp     eax, 0
.text:08000B5B                 jz      hite_2
.text:08000B61                 jmp     hite_3
.text:08000B66 ; ---------------------------------------------------------------------------
.text:08000B66
.text:08000B66 hite_2:                                 ; ...
.text:08000B66                 mov     eax, 0          ; return NULL; /* Uninitialized table */
.text:08000B6B                 jmp     hite_8
.text:08000B70 ; ---------------------------------------------------------------------------
.text:08000B70
.text:08000B70 hite_3:                                 ; ...
.text:08000B70                 mov     eax, [ebp+np]   ; while (np < ep) {
.text:08000B73                 mov     ecx, [ebp+ep]
.text:08000B76                 cmp     eax, ecx
.text:08000B78                 jnb     hite_6
.text:08000B7E                 mov     eax, [ebp+np]
.text:08000B81                 add     eax, 8          ; np->key
.text:08000B84                 mov     ecx, [eax]
.text:08000B86                 cmp     ecx, 0          ; if (np->key) {
.text:08000B89                 jz      hite_5
.text:08000B8F                 mov     eax, [ebp+iterator]
.text:08000B92                 mov     ecx, [ebp+np]
.text:08000B95                 add     ecx, 16
.text:08000B98                 mov     [eax], ecx      ; *iterator = np + 1;
.text:08000B9A                 mov     eax, [ebp+key]
.text:08000B9D                 cmp     eax, 0          ; if (key)
.text:08000BA0                 jz      hite_4
.text:08000BA6                 mov     eax, [ebp+key]
.text:08000BA9                 mov     ecx, [ebp+np]
.text:08000BAC                 add     ecx, 8
.text:08000BAF                 mov     edx, [ecx]
.text:08000BB1                 mov     [eax], edx      ; *key = np->key;
.text:08000BB3
.text:08000BB3 hite_4:                                 ; ...
.text:08000BB3                 mov     eax, [ebp+np]
.text:08000BB6                 add     eax, 12
.text:08000BB9                 mov     [ebp+tmp], eax
.text:08000BBC                 mov     eax, [ebp+tmp]
.text:08000BBF                 mov     eax, [eax]      ; return np->data;
.text:08000BC1                 jmp     hite_8
.text:08000BC6 ; ---------------------------------------------------------------------------
.text:08000BC6
.text:08000BC6 hite_5:                                 ; ...
.text:08000BC6                 mov     eax, [ebp+np]
.text:08000BC9                 mov     ecx, eax
.text:08000BCB                 add     eax, 16         ; + structure size
.text:08000BCE                 mov     [ebp+np], eax   ; np++;
.text:08000BD1                 jmp     short hite_3
.text:08000BD3 ; ---------------------------------------------------------------------------
.text:08000BD3
.text:08000BD3 hite_6:                                 ; ...
.text:08000BD3                 mov     eax, [ebp+iterator]
.text:08000BD6                 mov     ecx, 0
.text:08000BDB                 mov     [eax], ecx      ; *iterator = NULL;
.text:08000BDD                 mov     eax, [ebp+key]
.text:08000BE0                 cmp     eax, 0          ; if (key)
.text:08000BE3                 jz      hite_7
.text:08000BE9                 mov     eax, [ebp+key]
.text:08000BEC                 mov     ecx, 0
.text:08000BF1                 mov     [eax], ecx      ; *key = NULL;
.text:08000BF3
.text:08000BF3 hite_7:                                 ; ...
.text:08000BF3                 mov     eax, 0
.text:08000BF8
.text:08000BF8 hite_8:                                 ; ...
.text:08000BF8                 leave                   ; return NULL;
.text:08000BF9                 retn
.text:08000BF9 hash_iterate    endp
.text:08000BF9
.text:08000BFA
.text:08000BFA ; =============== S U B R O U T I N E =======================================
.text:08000BFA
.text:08000BFA ; Attributes: bp-based frame
.text:08000BFA
.text:08000BFA                 public hash_free
.text:08000BFA hash_free       proc near               ; ...
.text:08000BFA
.text:08000BFA p               = dword ptr -4
.text:08000BFA head            = dword ptr  8
.text:08000BFA
.text:08000BFA                 push    ebp             ; /* Free the hash itself. Doesn't free the data elements; use
.text:08000BFA                                         ;    hash_iterate() to do that first, if needed.
.text:08000BFA                                         ;    This function is normally used when the hash data entries are
.text:08000BFA                                         ;    either freed separately, or compound objects which can't be
.text:08000BFA                                         ;    freed in a single operation. */
.text:08000BFA                                         ;
.text:08000BFA                                         ; void hash_free(struct hash_table *head)
.text:08000BFB                 mov     ebp, esp
.text:08000BFD                 sub     esp, 4
.text:08000C03                 nop
.text:08000C04                 mov     eax, [ebp+head]
.text:08000C07                 mov     ecx, [eax]
.text:08000C09                 mov     [ebp+p], ecx    ; void *p = head->table;
.text:08000C0C                 mov     eax, [ebp+head]
.text:08000C0F                 mov     ecx, 0
.text:08000C14                 mov     [eax], ecx      ; head->table = NULL;
.text:08000C16                 mov     eax, [ebp+p]
.text:08000C19                 push    eax
.text:08000C1A                 call    nasm_free       ; nasm_free(p);
.text:08000C1F                 add     esp, 4
.text:08000C22                 leave
.text:08000C23                 retn
.text:08000C23 hash_free       endp
.text:08000C23
.text:08000C24
.text:08000C24 ; =============== S U B R O U T I N E =======================================
.text:08000C24
.text:08000C24 ; Attributes: bp-based frame
.text:08000C24
.text:08000C24                 public hash_free_all
.text:08000C24 hash_free_all   proc near
.text:08000C24
.text:08000C24 d               = dword ptr -0Ch
.text:08000C24 keyp            = dword ptr -8
.text:08000C24 iter            = dword ptr -4
.text:08000C24 head            = dword ptr  8
.text:08000C24 free_keys       = dword ptr  0Ch
.text:08000C24
.text:08000C24                 push    ebp             ; /* Frees the hash *and* all data elements. This is applicable only in
.text:08000C24                                         ;    the case where the data element is a single allocation. If the
.text:08000C24                                         ;    second argument is false, the key string is part of the data
.text:08000C24                                         ;    allocation or belongs to an allocation which will be freed
.text:08000C24                                         ;    separately, if it is true the keys are also freed. */
.text:08000C24                                         ;
.text:08000C24                                         ; void hash_free_all(struct hash_table *head, bool free_keys)
.text:08000C25                 mov     ebp, esp
.text:08000C27                 sub     esp, 12
.text:08000C2D                 nop
.text:08000C2E                 mov     eax, 0
.text:08000C33                 mov     [ebp+iter], eax ; struct hash_tbl_node *iter = NULL;
.text:08000C36
.text:08000C36 hfa_1:                                  ; ...
.text:08000C36                 lea     eax, [ebp+keyp] ; const char *keyp;
.text:08000C39                 push    eax
.text:08000C3A                 lea     eax, [ebp+iter]
.text:08000C3D                 push    eax
.text:08000C3E                 mov     eax, [ebp+head]
.text:08000C41                 push    eax
.text:08000C42                 call    hash_iterate
.text:08000C47                 add     esp, 12         ; void *d;
.text:08000C4A                 mov     [ebp+d], eax
.text:08000C4D                 cmp     eax, 0          ; while ((d = hash_iterate(head, &iter, &keyp))) {
.text:08000C50                 jz      hfa_3
.text:08000C56                 mov     eax, [ebp+d]
.text:08000C59                 push    eax
.text:08000C5A                 call    nasm_free       ; nasm_free(d);
.text:08000C5F                 add     esp, 4
.text:08000C62                 mov     eax, [ebp+free_keys] ; if (free_keys)
.text:08000C65                 cmp     eax, 0
.text:08000C68                 jz      hfa_2
.text:08000C6E                 mov     eax, [ebp+keyp]
.text:08000C71                 push    eax
.text:08000C72                 call    nasm_free       ; nasm_free((void *)keyp);
.text:08000C77                 add     esp, 4
.text:08000C7A
.text:08000C7A hfa_2:                                  ; ...
.text:08000C7A                 jmp     short hfa_1
.text:08000C7C ; ---------------------------------------------------------------------------
.text:08000C7C
.text:08000C7C hfa_3:                                  ; ...
.text:08000C7C                 mov     eax, [ebp+head]
.text:08000C7F                 push    eax
.text:08000C80                 call    hash_free       ; hash_free(head);
.text:08000C85                 add     esp, 4
.text:08000C88                 leave
.text:08000C89                 retn
.text:08000C89 hash_free_all   endp
.text:08000C89
