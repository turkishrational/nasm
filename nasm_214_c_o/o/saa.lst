.text:08000EB3                 shl     ecx, 24
.text:08000EB6                 sar     ecx, 24
.text:08000EB9                 mov     [eax], cl       ; *ptemp = byte;
.text:08000EBB                 mov     eax, [ebp+ptemp]
.text:08000EBE                 mov     ecx, eax
.text:08000EC0                 inc     eax
.text:08000EC1                 mov     [ebp+ptemp], eax ; ptemp++;
.text:08000EC4                 mov     eax, [ebp+len]
.text:08000EC7                 mov     ecx, eax
.text:08000EC9                 inc     eax
.text:08000ECA                 mov     [ebp+len], eax  ; len++;
.text:08000ECD                 mov     eax, [ebp+value]
.text:08000ED0                 cmp     eax, 0
.text:08000ED3                 jnz     swlu_1          ; } while (value != 0);
.text:08000ED9                 mov     eax, [ebp+len]
