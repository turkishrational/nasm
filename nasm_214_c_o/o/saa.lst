.text:08000F67                 mov     ecx, 0
.text:08000F6C                 sub     ecx, eax        ; neg
.text:08000F6E                 mov     eax, [ebp+value]
.text:08000F71                 or      eax, ecx
.text:08000F73                 mov     [ebp+value], eax ; value |= -(1 << (size - 7));
.text:08000F76
.text:08000F76 swls_2:                                 ; ...
.text:08000F76                 mov     eax, [ebp+value] ; /* sign bit of byte is second high order bit (0x40) */
