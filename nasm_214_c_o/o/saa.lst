.text:08000E81
.text:08000E81 swlu_1:                                 ; ...
.text:08000E81                 mov     eax, [ebp+value] ; do {
.text:08000E84                 and     eax, 7Fh
.text:08000E87                 mov     [ebp+byte], al  ; byte = value & 127;
.text:08000E8A                 mov     eax, [ebp+value]
.text:08000E8D                 sar     eax, 7
.text:08000E90                 mov     [ebp+value], eax ; value >>= 7;
.text:08000E93                 mov     eax, [ebp+value]
.text:08000E96                 cmp     eax, 0          ; if (value != 0) /* more bytes to come */
.text:08000E99                 jz      swlu_2
